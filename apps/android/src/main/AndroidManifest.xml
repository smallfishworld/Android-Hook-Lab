<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="dev.smallfish.hooklab.permission.EVENT_WRITE"
        android:protectionLevel="signature"
        android:label="Hook Lab demo event permission"/>
    <queries>
        <package android:name="dev.smallfish.hooklab.demo"/>
    </queries>
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Android Hook Lab"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".TraceAnalysisActivity" android:exported="false"/>
        <activity android:name=".MobileHookActivity" android:exported="false"/>
        <provider
            android:name=".storage.MobileControlProvider"
            android:authorities="dev.smallfish.hooklab.control"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="dev.smallfish.hooklab.permission.EVENT_WRITE"
            android:writePermission="dev.smallfish.hooklab.permission.EVENT_WRITE"/>
        <provider
            android:name=".storage.EventProvider"
            android:authorities="dev.smallfish.hooklab.events"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="dev.smallfish.hooklab.permission.EVENT_WRITE"
            android:writePermission="dev.smallfish.hooklab.permission.EVENT_WRITE"/>
    </application>
</manifest>
